# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=metaglass              # PostgreSQL superuser username
POSTGRES_PASSWORD=changeme           # PostgreSQL superuser password
POSTGRES_DB=metaglass                # PostgreSQL database name
POSTGRES_HOST=postgres-postgis       # Hostname of the PostGIS service on metaglass-net
POSTGRES_PORT=5432                   # PostgreSQL port

# ── Tailscale / Network ─────────────────────────────────────────────────────
TAILSCALE_GN100_IP=100.x.x.x         # Tailscale IP of the GN100; used to bind WS port
TAILSCALE_GN100_PORT=8080            # WebSocket server port

# ── Riva ASR ────────────────────────────────────────────────────────────────
RIVA_ASR_HOST=riva-asr               # Hostname of the Riva ASR service on metaglass-net
RIVA_ASR_PORT=50051                  # Riva ASR gRPC port
RIVA_ASR_SAMPLE_RATE=16000           # PCM sample rate expected by Riva ASR
RIVA_ASR_LANGUAGE_CODE=en-US         # Language code for ASR recognition


# ── Nemotron NIM ────────────────────────────────────────────────────────────
NEMOTRON_NIM_HOST=nemotron-nim       # Hostname of the Nemotron NIM service on metaglass-net
NEMOTRON_NIM_PORT=8000               # Nemotron NIM HTTP port
NEMOTRON_MODEL_NAME=nemotron-3-nano-30b-a3b  # Model name for NIM API calls

# ── NemoClaw ────────────────────────────────────────────────────────────────
NEMOCLAW_HOST=nemoclaw               # Hostname of the NemoClaw service on metaglass-net
NEMOCLAW_PORT=8090                   # NemoClaw HTTP API port
NEMOCLAW_CONFIDENCE_THRESHOLD=0.7    # Minimum intent classification confidence to invoke a tool

# ── Data Pipeline ───────────────────────────────────────────────────────────
SOCRATA_APP_TOKEN=your_token_here    # NYC Open Data Socrata API token
SOCRATA_RESTAURANT_ENDPOINT=https://data.cityofnewyork.us/resource/43nn-pn8j.csv
SOCRATA_COLLISION_ENDPOINT=https://data.cityofnewyork.us/resource/h9gi-nx95.json
SOCRATA_311_ENDPOINT=https://data.cityofnewyork.us/resource/erm2-nwe9.json
MTA_GTFS_RT_ENDPOINT=https://api-endpoint.mta.info/Dataservice/mtagtfsfeeds/nyct%2Fgtfs
MTA_API_KEY=your_mta_key_here        # MTA BusTime/SubwayTime API key
PIPELINE_CRON_HOUR=2                 # UTC hour for nightly pipeline cron (0-23)
PIPELINE_CRON_MINUTE=0               # UTC minute for nightly pipeline cron (0-59)

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info                       # Pino log level: trace|debug|info|warn|error|fatal
NODE_ENV=production                  # Node.js environment
